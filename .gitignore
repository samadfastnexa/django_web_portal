# Ignore Python bytecode
__pycache__/
*.pyc
*.pyo

# Ignore virtual environment
venv/

# Ignore Django database and runtime files
web_portal/db.sqlite3
web_portal/media/
web_portal/staticfiles/
web_portal/.env
web_portal/*.log

# Ignore runtime log files (regenerated fresh on each server via LOG_DIR.mkdir)
web_portal/logs/*.log
web_portal/logs/*.log.*

# Environment files
.env
*.env

# Secrets / keys / local settings (never commit)
*.pem
*.key
*.sqlite3
settings_local.py
local_settings.py
secrets.json
credentials.json

# Ignore editor/IDE settings
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db